# Telegram BotFather token
BOT_TOKEN=123456789:replace_me

# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@localhost:5432/uzbektoe

# Public HTTPS domain without the webhook path
WEBHOOK_BASE_URL=https://your-service.up.railway.app
WEBHOOK_PATH=/webhook

# 1-256 chars: A-Z, a-z, 0-9, underscore and hyphen only
WEBHOOK_SECRET=replace_with_a_long_random_secret

ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
